POSTGRES_USER=dispatch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dispatch_hub
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SSRF_ALLOW_LOOPBACK=true
# true for full Compose (webhook-echo is RFC1918); keep false for host-only / production
SSRF_ALLOW_PRIVATE=true
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost
DISPATCH_WORKER_ID=compose-api-1
